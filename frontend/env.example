
# Copy to .env.local (Vite picks up VITE_ prefixed vars)

# ============================================================================
# Backend API Configuration
# ============================================================================
# Development: Use local backend
# Production: Use your deployed backend URL (Render, Railway, VPS, etc.)
# Examples:
#   Local: VITE_API_BASE_URL=http://localhost:8000
#   Render: VITE_API_BASE_URL=https://medai-backend.onrender.com
#   Custom domain: VITE_API_BASE_URL=https://api.medai.yourdomain.com
VITE_API_BASE_URL=http://localhost:8000

# ============================================================================
# Firebase Configuration
# ============================================================================
# Get these values from Firebase Console → Project Settings → General → Your apps
# These are PUBLIC values (safe to expose in frontend code)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Firebase Analytics Measurement ID
# Find in Firebase Console → Project Settings → General → Your apps
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================================
# Optional: Feature Flags
# ============================================================================
# Enable/disable analytics tracking
VITE_ENABLE_ANALYTICS=false

