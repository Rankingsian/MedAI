# Copy to .env (backend expects a .env file at backend/.env)
# Replace the placeholders with your real values. Do NOT commit secrets to public repos.

# Firebase
FIREBASE_PROJECT_ID=
# Path to Firebase service account JSON (optional if using other auth flows). Relative to backend/ or absolute.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Firebase Admin (optional)
FIREBASE_DATABASE_URL=

# Groq API Key (RECOMMENDED for best AI features)
# Get your FREE API key from: https://console.groq.com/keys
# No credit card required! 14,400 requests per day free
# Uses Llama 3.1 70B - excellent for medical consultations
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face API Key (OPTIONAL - Groq is better)
# Get your API key from: https://huggingface.co/settings/tokens
# IMPORTANT: Create token with "Write" access (NOT just "Read")
# This enables remote AI model inference without downloading models locally
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Model names (optional)
# Primary generative model for conversations (e.g., microsoft/BioGPT-Large)
AI_MODEL_NAME=microsoft/BioGPT-Large
# Embeddings model (sentence-transformers or other)
EMBEDDINGS_MODEL=sentence-transformers/all-mpnet-base-v2

# Local Tesseract path (if Tesseract is installed at a non-standard path)
TESSERACT_CMD=

# Environment and server
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Optional: force device selection for transformers (cpu/cuda)
TRANSFORMERS_DEVICE=auto
