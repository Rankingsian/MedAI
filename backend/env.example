# Copy to .env (backend expects a .env file at backend/.env)
# Replace the placeholders with your real values. Do NOT commit secrets to public repos.

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed frontend origins
# Development: Use "*" or list specific origins
# Production: MUST list specific domains (security requirement)
# Examples:
#   Development: CORS_ORIGINS=*
#   Production: CORS_ORIGINS=https://medai.vercel.app,https://medai.yourdomain.com
#   Mixed: CORS_ORIGINS=http://localhost:5173,https://medai.vercel.app
CORS_ORIGINS=*

# ============================================================================
# Firebase Configuration
# ============================================================================
FIREBASE_PROJECT_ID=

# --- METHOD 1: Service Account JSON as Environment Variable (RECOMMENDED for Render/Vercel) ---
# Copy the ENTIRE contents of your firebase-service-account.json file as a single-line JSON string
# This is the most secure method for cloud platforms
# To convert your JSON file to a single line (removes newlines):
#   cat firebase-service-account.json | jq -c
# Or on Windows PowerShell:
#   (Get-Content firebase-service-account.json) -join '' 
# Then paste the result here:
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- METHOD 2: Service Account JSON File Path (For VPS/Docker deployments) ---
# Path to Firebase service account JSON file (relative to backend/ or absolute)
# Ensure this file is in .gitignore and NOT committed to version control
# Only use this if deploying to a VPS or using Docker with volume mounts
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Optional: Firebase Realtime Database URL (only if using Realtime Database)
FIREBASE_DATABASE_URL=

# Groq API Key (RECOMMENDED for best AI features)
# Get your FREE API key from: https://console.groq.com/keys
# No credit card required! 14,400 requests per day free
# Uses Llama 3.1 70B - excellent for medical consultations
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face API Key (OPTIONAL - Groq is better)
# Get your API key from: https://huggingface.co/settings/tokens
# IMPORTANT: Create token with "Write" access (NOT just "Read")
# This enables remote AI model inference without downloading models locally
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Model names (optional)
# Primary generative model for conversations (e.g., microsoft/BioGPT-Large)
AI_MODEL_NAME=microsoft/BioGPT-Large
# Embeddings model (sentence-transformers or other)
EMBEDDINGS_MODEL=sentence-transformers/all-mpnet-base-v2

# Local Tesseract path (if Tesseract is installed at a non-standard path)
TESSERACT_CMD=

# Environment and server
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Optional: force device selection for transformers (cpu/cuda)
TRANSFORMERS_DEVICE=auto
