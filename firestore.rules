rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is a clinician
    function isClinician() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/clinicians/$(request.auth.uid));
    }
    
    // Helper function to get user role from users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper function to check if user is a doctor/clinician via users collection
    function isDoctor() {
      return isAuthenticated() && getUserRole() == 'doctor';
    }
    
    // ==========================================================================
    // Users Collection - User Profiles
    // ==========================================================================
    match /users/{userId} {
      // Users can only read and write their own profile
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
    
    // ==========================================================================
    // Clinicians Collection - Clinician Profiles and Credentials
    // ==========================================================================
    match /clinicians/{clinicianId} {
      // Any authenticated user can read clinician profiles (for directory)
      allow read: if isAuthenticated();
      
      // Only the clinician can update their own profile
      allow write: if isOwner(clinicianId);
      
      // Admin creation (would require custom claims or admin SDK)
      // For now, clinicians are created via backend script
    }
    
    // ==========================================================================
    // Consultations Collection - Chat History and AI Responses
    // ==========================================================================
    match /consultations/{consultId} {
      // Patients can read their own consultations
      // Clinicians can read all consultations
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isClinician() ||
        isDoctor()
      );
      
      // Any authenticated user can create a consultation
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Patients can update their own consultations
      // Clinicians can update any consultation (for adding reviews)
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isClinician() ||
        isDoctor()
      );
      
      // Only the owner can delete their consultation
      allow delete: if isOwner(resource.data.userId);
    }
    
    // ==========================================================================
    // Lab Reports Collection - Uploaded Lab Results
    // ==========================================================================
    match /lab_reports/{reportId} {
      // Patients can read their own lab reports
      // Clinicians can read all lab reports
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isClinician() ||
        isDoctor()
      );
      
      // Any authenticated user can create a lab report for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Patients can update their own lab reports
      // Clinicians can update any lab report (for adding reviews)
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isClinician() ||
        isDoctor()
      );
      
      // Only the owner can delete their lab report
      allow delete: if isOwner(resource.data.userId);
    }
    
    // ==========================================================================
    // Consultation Requests Collection - Patient-Clinician Connection
    // ==========================================================================
    match /consultation_requests/{requestId} {
      // Patients can read requests they created
      // Clinicians can read requests assigned to them or unassigned requests
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        (isClinician() || isDoctor()) && (
          resource.data.clinicianId == request.auth.uid ||
          !('clinicianId' in resource.data) ||
          resource.data.clinicianId == null
        )
      );
      
      // Any authenticated patient can create a consultation request
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      
      // Patients can update their own requests (e.g., cancel)
      // Clinicians can update requests to accept them or provide notes
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isClinician() ||
        isDoctor()
      );
      
      // Only the patient can delete their request
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }
    
    // ==========================================================================
    // Clinical Notes Collection - Clinician's notes on consultations
    // ==========================================================================
    match /clinical_notes/{noteId} {
      // Only the assigned clinician and the patient can read the note
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.clinicianId == request.auth.uid
      );
      
      // Only clinicians can create clinical notes
      allow create: if (isClinician() || isDoctor()) && 
                       request.resource.data.clinicianId == request.auth.uid;
      
      // Only the clinician who created the note can update it
      allow update: if isAuthenticated() && resource.data.clinicianId == request.auth.uid;
      
      // Only the clinician who created the note can delete it
      allow delete: if isAuthenticated() && resource.data.clinicianId == request.auth.uid;
    }
    
    // ==========================================================================
    // Reviews Collection - Doctor Reviews and Sign-offs
    // ==========================================================================
    match /reviews/{reviewId} {
      // Any authenticated user can read reviews
      allow read: if isAuthenticated();
      
      // Only clinicians/doctors can create and update reviews
      allow write: if (isClinician() || isDoctor()) && 
                      request.resource.data.doctorId == request.auth.uid;
      
      // Only the doctor who created the review can delete it
      allow delete: if isAuthenticated() && resource.data.doctorId == request.auth.uid;
    }
    
    // ==========================================================================
    // Default Deny All - Security by Default
    // ==========================================================================
    // Deny access to all other collections not explicitly defined
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
